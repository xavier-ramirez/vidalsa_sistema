APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# NO SUBIR de 12. El coste de bcrypt es exponencial: 12 gasta ~540ms por login y 15 ~4300ms,
# y ademas Laravel REHASHEA en el mismo request cuando el coste guardado no coincide con este,
# asi que se paga doble. Con 15 en produccion el login se caia por timeout para todos.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file: rapida y sin consultas a MySQL mientras haya UN solo contenedor (ver config/cache.php).
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Drive (documentos de equipos y catalogo). OJO: CLIENT_ID y REFRESH_TOKEN son
# largos y NO llevan comillas; si el editor del panel los corta al pegar, la app deja de
# abrir los PDF y muestra "Documento no disponible" (el catch de GoogleDriveController
# tapa el error real, hay que mirar storage/logs/laravel.log). Al pegarlos, comprobar que
# CLIENT_ID termina en .apps.googleusercontent.com y que el token no quedo truncado.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CATALOG_FOLDER_ID=
GOOGLE_DRIVE_PRODUCT_FOLDER_ID=
GOOGLE_DRIVE_EQUIPMENT_FOLDER_ID=

# Gemini (Google) — segundo lector de documentos. Sin clave, el sistema lee como siempre
# (OCR de Drive + reglas) y no pasa nada: la IA solo entra cuando esa lectura no alcanza.
# La clave se saca en https://aistudio.google.com/apikey y NO se sube al repositorio.
# Los valores por defecto son los topes del plan GRATIS (medidos 22-09-2026).
GEMINI_API_KEY=
# Lo de abajo NO hace falta ponerlo: son los valores que ya trae config/services.php. Estan
# aqui para poder subirlos sin tocar codigo si algun dia se paga un plan con mas cupo.
# GEMINI_MODELO=gemini-3.5-flash-lite     # el de diario (carga masiva)
# GEMINI_RPM=15                           # consultas por minuto
# GEMINI_RPD=450                          # consultas al dia
# GEMINI_MODELO_DIFICIL=gemini-3.8-flash  # el de los casos duros (revision nocturna)
# GEMINI_RPD_DIFICIL=18                   # su cupo diario, que es minimo
# GEMINI_TIMEOUT=75                       # segundos de espera por documento
