<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Las pruebas IGNORAN la configuracion cacheada.
             Sin esto, con bootstrap/cache/config.php presente (php artisan config:cache, que
             en local esta puesto porque quita ~30-60 ms por peticion) las variables de este
             archivo NO se aplican: la configuracion ya viene resuelta del .env y las pruebas
             saldrian apuntando a la base MySQL de trabajo. Como hay casos con RefreshDatabase
             (migrate:fresh), eso habria borrado la base real.
             APP_CONFIG_CACHE apunta a un archivo que nunca existe, asi que en pruebas la
             configuracion se arma siempre desde config/ + estas variables.
             La segunda red es Tests\TestCase::prohibirBaseReal. -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.pruebas-no-existe.php"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
