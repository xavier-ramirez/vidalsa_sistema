# Generadores y entregables desechables sueltos en la raíz (no forman parte de la app)
/*.py
/*.xlsx
/*.sql
/*.png
# Reportes generados sueltos en la raíz (p.ej. report_rotc_missing.txt): salida de
# scripts puntuales, no forman parte de la app. No hay ningún .txt trackeado en la raíz.
/*.txt
# Scripts locales de importación de la BD: llevan rutas absolutas de una máquina
# concreta y hacen DROP DATABASE. Nunca deben viajar en el repo.
/*.bat

# Scripts PHP de diagnóstico/migración puntuales sueltos en la RAÍZ (check_*, list_*,
# fix_*, report_*, migrate_*, update_tables*, export_sql, compare_*): se escriben para
# una consulta concreta y se abandonan; no forman parte de la app. Se anclan con "/"
# para que solo apliquen a la raíz — dentro de app/, database/, etc. sí son código real.
/check_*.php
/list_*.php
/fix_*.php
/report_*.php
/migrate_*.php
/update_tables*.php
/export_sql.php
/compare_*.php
# Misma familia: extractores puntuales (leer un Excel/PPTX, buscar un producto en la BD)
# escritos para responder UNA pregunta.
#
# Los scripts que SÍ hay que conservar (los que regeneran assets versionados: la faja
# petrolífera y las miniaturas del mapa) viven en tools/ — esa carpeta no está ignorada.
# Si escribes un generador que valga la pena guardar, va en tools/, no en la raíz.
/find_*.php
/get_*.php
# Recargas puntuales de tablas desde un .sql de respaldo (hacen TRUNCATE y leen de una
# ruta del disco de quien lo escribio): de un solo uso y peligrosas fuera de local.
/reload_*.php
